+/**
+  @brief Writes one line of the swap trace for the swap just made.
+
+  @details The line is "x xindex yindex score nodes leg": the level x of
+  the upper of the two swapped variables, the indices of the variables
+  that were at levels x and x+1 before the swap, the size sifting
+  compares after it (keys - isolated, what cuddSwapInPlace returns), the
+  internal nodes after it (keys - constants.keys), and the leg letter.
+
+  @sideeffect Opens the trace file at the first swap.
+
+*/
+static void
+ddSwapTrace(
+  DdManager * table,
+  int x,
+  int xindex,
+  int yindex)
+{
+    if (ddSwapTraceState == 0) {
+	const char *name = getenv("CUDD_SWAP_TRACE");
+	ddSwapTraceState = 1;
+	if (name != NULL && name[0] != '\0') {
+	    ddSwapTraceFile = fopen(name, "w");
+	    if (ddSwapTraceFile != NULL) ddSwapTraceState = 2;
+	}
+	if (ddSwapTraceState != 2) return;
+    }
+    (void) fprintf(ddSwapTraceFile, "%d %d %d %u %u %c\n", x, xindex, yindex,
+		   table->keys - table->isolated,
+		   table->keys - table->constants.keys, ddSwapTraceLeg);
+}
