+/* Swap trace (Sylvan's benchmark/sift/cudd-swap-trace.patch): when the
+** environment variable CUDD_SWAP_TRACE names a file, cuddSwapInPlace writes
+** one line per swap to it. The state is 0 before the first swap has looked
+** at the variable, 1 when it is not set, 2 when tracing. The leg letter is
+** set by ddSiftingUp (u), ddSiftingDown (d) and ddSiftingBackward (b); swaps
+** made by other reordering methods carry whichever letter was set last. */
+static FILE *ddSwapTraceFile = NULL;
+static int ddSwapTraceState = 0;
+static char ddSwapTraceLeg = '?';
+
