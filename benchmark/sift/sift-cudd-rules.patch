+/** Whether the environment variable <name> is set to something but 0. */
+static int
+sift_cudd_flag(const char *name)
+{
+    const char *value = getenv(name);
+    return value != NULL && value[0] != '\0' && strcmp(value, "0") != 0;
+}
+
+/**
+ * Whether the last move grew the forest past the growth bound. CUDD's test,
+ * in ddSiftingUp and ddSiftingDown, is (double)size > limitSize * maxGrowth
+ * with maxGrowth a double and sizes that count its constants; the driver's
+ * compares sizes without them against a float factor. <limit> already
+ * includes the size the move reached, which changes neither test.
+ */
+static int
+sift_grown(const struct sift_run *run, uint64_t limit)
+{
+    if (run->cudd_growth) {
+        return (double)(run->size + run->cudd_constants) >
+               (double)(limit + run->cudd_constants) * run->cudd_factor;
+    }
+    return (double)run->size > run->growth * (double)limit;
+}
+
+/** The second leg's moves, which CUDD's return considers alone. */
+static void
+sift_record(struct sift_run *run, uint32_t top)
+{
+    if (!run->recording) return;
+    run->second_top[run->second_count] = top;
+    run->second_size[run->second_count] = run->size;
+    run->second_count++;
+}
